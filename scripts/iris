#!/bin/bash
# Iris pipeline management CLI
# Usage: iris {start|stop|restart|run|status|monitor|logs}

set -euo pipefail

IRIS="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"
DAEMON_PY="$IRIS/scripts/daemon.py"
MONITOR_PY="$IRIS/scripts/monitor.py"
DAEMON_JSON="$IRIS/pipeline/daemon.json"
LOG_DIR="$IRIS/logs"
PYTHON="python3"

_daemon_pid() {
    $PYTHON -c "
import json, sys
try:
    d = json.loads(open('$DAEMON_JSON').read())
    print(d['pid'])
except Exception:
    sys.exit(1)
" 2>/dev/null || true
}

_daemon_running() {
    local pid
    pid=$(_daemon_pid) || return 1
    [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null
}

cmd_start() {
    if _daemon_running; then
        local pid
        pid=$(_daemon_pid)
        echo "Daemon already running (PID $pid)"
        exit 1
    fi
    mkdir -p "$LOG_DIR"
    local log_file="$LOG_DIR/daemon-$(date +%Y%m%d).log"
    nohup "$PYTHON" "$DAEMON_PY" >> "$log_file" 2>&1 &
    local pid=$!
    echo "Daemon started (PID $pid) — log: $log_file"
    echo "Run 'iris monitor' to watch progress."
}

cmd_stop() {
    local pid
    pid=$(_daemon_pid) || { echo "No daemon state found."; exit 1; }
    if ! kill -0 "$pid" 2>/dev/null; then
        echo "Daemon (PID $pid) is not running."
        exit 1
    fi
    kill "$pid"
    echo "Daemon stopped (PID $pid)."
}

cmd_restart() {
    if _daemon_running; then
        cmd_stop
        sleep 2
    fi
    cmd_start
}

cmd_status() {
    if ! [ -f "$DAEMON_JSON" ]; then
        echo "No daemon state file found. Has it ever been started?"
        exit 1
    fi
    $PYTHON -c "
import json, sys
from datetime import datetime, timezone

d = json.loads(open('$DAEMON_JSON').read())
status      = d.get('status', 'unknown')
pid         = d.get('pid', '?')
msg         = d.get('message', '')
started     = d.get('started_at', '')
sleep_until = d.get('sleep_until')

icon = {'running': '●', 'sleeping': '◔', 'stopped': '○', 'starting': '◌'}.get(status, '?')
print(f'{icon}  {status.upper()}   PID {pid}')
print(f'   {msg}')

if started:
    try:
        dt = datetime.fromisoformat(started).astimezone()
        print(f'   Started : {dt.strftime(\"%Y-%m-%d %H:%M %Z\")}')
    except Exception:
        pass

if sleep_until and status == 'sleeping':
    try:
        wake = datetime.fromisoformat(sleep_until).astimezone()
        secs = int((wake - datetime.now(tz=wake.tzinfo)).total_seconds())
        if secs > 0:
            h, r = divmod(secs, 3600); m, s = divmod(r, 60)
            fmt = f'{h}h {m}m' if h else f'{m}m {s}s'
            print(f'   Wakes in: {fmt}')
    except Exception:
        pass
"
}

cmd_monitor() {
    if ! $PYTHON -c "import rich" 2>/dev/null; then
        echo "Error: 'rich' Python package not found. Install with: pip install rich"
        exit 1
    fi
    "$PYTHON" "$MONITOR_PY"
}

cmd_run() {
    if _daemon_running; then
        local pid status
        pid=$(_daemon_pid)
        status=$($PYTHON -c "
import json, sys
try:
    d = json.loads(open('$DAEMON_JSON').read())
    print(d.get('status', 'unknown'))
except Exception:
    print('unknown')
")
        case "$status" in
            sleeping)
                kill -USR1 "$pid"
                echo "Woke daemon (PID $pid) — pipeline cycle starting now."
                echo "Run 'iris monitor' to watch progress."
                ;;
            running)
                echo "Pipeline is already running (PID $pid). Nothing to do."
                ;;
            *)
                echo "Daemon is in state '$status'. Use 'iris restart' to force a clean restart."
                ;;
        esac
    else
        echo "Daemon is not running — starting it now."
        cmd_start
    fi
}

cmd_logs() {
    local log
    log=$(ls -t "$LOG_DIR"/daemon-*.log 2>/dev/null | head -1 || true)
    if [ -z "$log" ]; then
        echo "No daemon log files found in $LOG_DIR"
        exit 1
    fi
    echo "Tailing $log  (Ctrl+C to stop)"
    tail -f "$log"
}

case "${1:-}" in
    start)   cmd_start   ;;
    stop)    cmd_stop    ;;
    restart) cmd_restart ;;
    run)     cmd_run     ;;
    status)  cmd_status  ;;
    monitor) cmd_monitor ;;
    logs)    cmd_logs    ;;
    *)
        echo "Iris pipeline manager"
        echo ""
        echo "Usage: iris <command>"
        echo ""
        echo "Commands:"
        echo "  start    Start the daemon in the background"
        echo "  stop     Stop the running daemon"
        echo "  restart  Stop then start the daemon"
        echo "  run      Kick off a pipeline cycle now (wakes daemon if sleeping)"
        echo "  status   Show current daemon status"
        echo "  monitor  Open the live terminal dashboard"
        echo "  logs     Tail the daemon log file"
        ;;
esac
