# Iris Environment Variables
# Copy to .env.local and fill in values. Never commit .env.local.

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/iris

# ── Vector Store ──────────────────────────────────────────────────────────────
QDRANT_URL=http://localhost:6333
# Leave empty to use pgvector instead of Qdrant
# QDRANT_API_KEY=

# ── Cache ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Embedding Service ────────────────────────────────────────────────────────
# Provider: openai | anthropic | local
EMBEDDING_PROVIDER=openai
OPENAI_API_KEY=

# ── Auth (Clerk) ──────────────────────────────────────────────────────────────
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=

# ── MCP Server ────────────────────────────────────────────────────────────────
MCP_SERVER_PORT=3100
MCP_API_KEY_SECRET=  # Used to sign workspace API keys

# ── Connector OAuth Encryption ────────────────────────────────────────────────
CONNECTOR_TOKEN_ENCRYPTION_KEY=  # 32-byte hex key for AES-256-GCM

# ── HubSpot Connector ────────────────────────────────────────────────────────
HUBSPOT_CLIENT_ID=
HUBSPOT_CLIENT_SECRET=

# ── Salesforce Connector ──────────────────────────────────────────────────────
SALESFORCE_CLIENT_ID=
SALESFORCE_CLIENT_SECRET=

# ── Notion Connector ──────────────────────────────────────────────────────────
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=

# ── Google Drive Connector ───────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Snowflake Connector ───────────────────────────────────────────────────────
# SNOWFLAKE_ACCOUNT=
# SNOWFLAKE_USERNAME=
# SNOWFLAKE_PRIVATE_KEY=

# ── Feature Flags ─────────────────────────────────────────────────────────────
ENABLE_SEMANTIC_CACHE=true
ENABLE_KNOWLEDGE_GRAPH=false  # Neo4j required when true
ENABLE_AUDIT_LOG=true

# ── Neo4j (optional, for knowledge graph) ────────────────────────────────────
# NEO4J_URI=bolt://localhost:7687
# NEO4J_USERNAME=neo4j
# NEO4J_PASSWORD=
