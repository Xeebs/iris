{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "Node16",
    "lib": ["ES2022"],
    "strict": true,
    "exactOptionalPropertyTypes": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "paths": {
      "@iris/connector-sdk": ["./packages/connector-sdk/src/index.ts"],
      "@iris/connector-sdk/*": ["./packages/connector-sdk/src/*.ts"],
      "@iris/core": ["./packages/core/src/index.ts"],
      "@iris/core/*": ["./packages/core/src/*.ts"],
      "@iris/semantic-core": ["./packages/semantic-core/src/index.ts"],
      "@iris/semantic-core/*": ["./packages/semantic-core/src/*.ts"],
      "@iris/cache": ["./packages/cache/src/index.ts"],
      "@iris/cache/*": ["./packages/cache/src/*.ts"],
      "@iris/compression": ["./packages/compression/src/index.ts"],
      "@iris/compression/*": ["./packages/compression/src/*.ts"],
      "@iris/graph": ["./packages/graph/src/index.ts"],
      "@iris/graph/*": ["./packages/graph/src/*.ts"]
    }
  },
  "exclude": ["node_modules", "dist", "**/__tests__/**"]
}
