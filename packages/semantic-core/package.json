{
  "name": "@iris/semantic-core",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./indexer": "./dist/indexer.js",
    "./retrieval": "./dist/retrieval.js",
    "./embedding": "./dist/embedding.js",
    "./vector-store": "./dist/vector-store.js",
    "./glossary": "./dist/glossary.js",
    "./metrics": "./dist/metrics.js",
    "./sync-events": "./dist/sync-events.js",
    "./connector-health-service": "./dist/connector-health-service.js",
    "./context-permissions": "./dist/context-permissions.js",
    "./schema-discoverer": "./dist/schema-discoverer.js",
    "./proactive-suggester": "./dist/proactive-suggester.js",
    "./osi-exporter": "./dist/osi-exporter.js",
    "./nlp-config-parser": "./dist/nlp-config-parser.js",
    "./workflow-templates": "./dist/workflow-templates.js",
    "./index-optimizer": "./dist/index-optimizer.js",
    "./benchmarking": "./dist/benchmarking.js"
