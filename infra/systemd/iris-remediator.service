[Unit]
Description=Iris CI Remediator — fires the pipeline-remediator agent on failed Actions runs
Documentation=https://github.com/Xeebs/iris
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=xhasan
WorkingDirectory=/home/xhasan/my-projects/Iris
ExecStart=/usr/bin/python3 /home/xhasan/my-projects/Iris/scripts/ci-remediator-watch.py
Restart=on-failure
RestartSec=60
StandardOutput=append:/home/xhasan/my-projects/Iris/logs/remediator.log
StandardError=append:/home/xhasan/my-projects/Iris/logs/remediator.log
EnvironmentFile=-/home/xhasan/my-projects/Iris/.env

[Install]
WantedBy=multi-user.target
